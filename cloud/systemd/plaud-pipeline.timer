# Runs the Plaud pipeline nightly. Install to /etc/systemd/system/ on teslamate-vm:
#   sudo systemctl daemon-reload && sudo systemctl enable --now plaud-pipeline.timer
[Unit]
Description=Nightly trigger for the Plaud pipeline

[Timer]
# 03:00 America/Los_Angeles (DST-safe; needs systemd >= 252). Persistent catches
# up a missed run after downtime.
OnCalendar=*-*-* 03:00:00 America/Los_Angeles
Persistent=true

[Install]
WantedBy=timers.target
